。</p>","params":[{"type":{"names":["Array","FeatureCollection"]},"description":"<p>点坐标数组，支持的形式为 [[x, y]]，[{x, y}]，点要素数组，也支持 FeatureCollection。</p>","name":"points"},{"type":{"names":["number"]},"description":"<p>凹包内最小角度。</p>","name":"angle"}],"returns":[{"type":{"names":["GeoJSONFeature"]},"description":"<p>结果要素。</p>"}],"memberof":"GeometryAnalysis","longname":"GeometryAnalysis#computeConcaveHullPoints","scope":"instance"},{"kind":"function","name":"isSegmentIntersect","version":"11.2.0","description":"<p>计算线段是否相交。</p>","params":[{"type":{"names":["number"]},"description":"<p>第一条线的起点X。</p>","name":"x1"},{"type":{"names":["number"]},"description":"<p>第一条线的起点Y。</p>","name":"y1"},{"type":{"names":["number"]},"description":"<p>第一条线的终点X。</p>","name":"x2"},{"type":{"names":["number"]},"description":"<p>第一条线的终点Y。</p>","name":"y2"},{"type":{"names":["number"]},"description":"<p>第二条线的起点X。</p>","name":"x3"},{"type":{"names":["number"]},"description":"<p>第二条线的起点Y。</p>","name":"y3"},{"type":{"names":["number"]},"description":"<p>第二条线的终点X。</p>","name":"x4"},{"type":{"names":["number"]},"description":"<p>第二条线的终点Y。</p>","name":"y4"}],"returns":[{"type":{"names":["boolean"]},"description":"<p>线是否相交。</p>"}],"memberof":"GeometryAnalysis","longname":"GeometryAnalysis#isSegmentIntersect","scope":"instance"},{"kind":"function","name":"isIntersectRegionWithRect","version":"11.2.0","description":"<p>几何对象与矩形是否相交分析。</p>","params":[{"type":{"names":["GeoJSONFeature"]},"description":"<p>要素。</p>","name":"feature"},{"type":{"names":["number"]},"description":"<p>矩形左坐标。</p>","name":"left"},{"type":{"names":["number"]},"description":"<p>矩形上坐标。</p>","name":"top"},{"type":{"names":["number"]},"description":"<p>矩形右坐标。</p>","name":"right"},{"type":{"names":["number"]},"description":"<p>矩形下坐标。</p>","name":"bottom"},{"type":{"names":["number"]},"optional":true,"defaultvalue":"1e-6","description":"<p>要素节点容限值。</p>","name":"tolerance"}],"returns":[{"type":{"names":["boolean"]},"description":"<p>要素是否与矩形相交。<