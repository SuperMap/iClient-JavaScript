[{"name":"Lang","kind":"namespace","tags":[{"originalTitle":"category","title":"category","text":"BaseTypes Internationalization","value":"BaseTypes Internationalization"}],"description":"<p>国际化的命名空间，包含多种语言和方法库来设置和获取当前的语言。</p>","usage":"<pre class=\"prettyprint source\"><code>// 浏览器\n&lt;script type=&quot;text/javascript&quot; src=&quot;https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js&quot;>&lt;/script>\n&lt;script>\n  const result = mapboxgl.supermap.Lang.getCode();\n\n  // 弃用的写法\n  const result = SuperMap.Lang.getCode();\n\n&lt;/script>\n\n// ES6 Import\nimport { Lang } from '@supermapgis/iclient-mapboxgl';\n\nconst result = Lang.getCode();\n\n</code></pre>","longname":"Lang","scope":"global"},{"kind":"member","name":"code","type":{"names":["string"]},"description":"<p>当前所使用的语言类型。</p>","memberof":"Lang","longname":"Lang.code","scope":"static"},{"kind":"member","name":"defaultCode","type":{"names":["string"]},"optional":true,"defaultvalue":"'en-US'","description":"<p>默认使用的语言类型。</p>","memberof":"Lang","longname":"Lang.defaultCode","scope":"static"},{"kind":"function","name":"getCode","description":"<p>获取当前的语言代码。</p>","returns":[{"type":{"names":["string"]},"description":"<p>当前的语言代码。</p>"}],"memberof":"Lang","longname":"Lang.getCode","scope":"static"},{"kind":"function","name":"setCode","description":"<p>设置语言代码。</p>","params":[{"type":{"names":["string"]},"description":"<p>此参数遵循IETF规范。</p>","name":"code"}],"memberof":"Lang","longname":"Lang.setCode","scope":"static"},{"kind":"function","name":"getLanguageFromCookie","description":"<p>从 cookie 中获取语言类型。</p>","memberof":"Lang","longname":"Lang.getLanguageFromCookie","scope":"static"},{"kind":"function","name":"i18n","description":"<p>从当前语言字符串的字典查找 key。</p>","params":[{"type":{"names":["string"]},"description":"<p>字典中 i18n 字符串值的关键字。</p>","name":"key"}],"returns":[{"type":{"names":["string"]},"description":"<p>国际化的字符串。</p>"}],"memberof":"Lang","longname":"Lang.i18n","scope":"static"}]