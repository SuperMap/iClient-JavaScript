[{"kind":"class","name":"FGBLayer","tags":[{"originalTitle":"category","title":"category","text":"Visualization FGB","value":"Visualization FGB"}],"classdesc":"<p>FGB 图层类。该图层把 {@link FlatGeobuf} 格式解析为点线面要素。\nFlatGeobuf（FGB）是一种用于存储地理要素的坐标、类型的二进制编码格式。\nFGB 格式与传统的 Shapefile、GeoJSON 等文件格式类似，支持地理空间矢量数据的存储，但 FGB 格式具有更高的存储效率和更快的读写速度，\n适用于大量静态数据的编码与传输。</p>","modulecategory":{"globalParams":{"monospaceLinks":true,"cleverLinks":true,"default":{"outputSourceFiles":false},"namespace":"mapboxgl.supermap","moduleName":"mapboxgl","npm":"@supermapgis/iclient-mapboxgl","cdn":"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js"},"category":"Overlay","name":"mapboxgl.supermap.FGBLayer","des_en":"FGBLayer","className":"FGBLayer","des":"FGB 图层"},"version":"11.1.0","params":[{"type":{"names":["Object"]},"description":"<p>参数。</p>","name":"options"},{"type":{"names":["string"]},"optional":true,"description":"<p>图层 ID。默认使用 CommonUtil.createUniqueID(&quot;FGBlayer_&quot;) 创建图层 ID。</p>","name":"options.layerID"},{"type":{"names":["string"]},"optional":true,"defaultvalue":"'bbox'","description":"<p>指定加载策略，可选值为 all，bbox。all 为全量加载， bbox 为当前可见范围加载。</p>","name":"options.strategy"},{"type":{"names":["Array"]},"optional":true,"description":"<p>加载范围，参数规范为: [minX, minY, maxX, maxY]，传递此参数后，图层将使用局部加载。</p>","name":"options.extent"},{"type":{"names":["function"]},"optional":true,"description":"<p>要素自定义方法，接收要素作为参数，需返回要素。</p>","name":"options.featureLoader"},{"type":{"names":["Object"]},"optional":true,"description":"<p>参数内容详见: {@link https://docs.mapbox.com/mapbox-gl-js/style-spec/layers/#paint-property}</p>","name":"options.paint"},{"type":{"names":["Object"]},"optional":true,"description":"<p>参数内容详见: {@link https://docs.mapbox.com/mapbox-gl-js/style-spec/layers/#layout-property}</p>","name":"options.layout"},{"type":{"names":["Object"]},"optional":true,"description":"<p>参数内容详见: {@link mapboxgl.source}</p>","name":"options.sourceOptions"}],"usage":{"className":"FGBLayer","aliasClass":"","globalParams":{"monospaceLinks":true,"cleverLinks":true,"default":{"outputSourceFiles":false},"namespace":"mapboxgl.supermap","moduleName":"mapboxgl","npm":"@supermapgis/iclient-mapboxgl","cdn":"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js"},"deprecatedClasses":[],"deprecatedClassInstance":null,"browserNamespace":""},"longname":"FGBLayer","scope":"global","usageCodeBrowser":"<script type='text/javascript' src=\"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js\"></script>\n<script>\n  new mapboxgl.supermap.FGBLayer(options, options.layerID, options.strategy, options.extent, options.featureLoader, options.paint, options.layout, options.sourceOptions);\n</script>","usageCodeES6":"import { FGBLayer } from '@supermapgis/iclient-mapboxgl';\n\nnew FGBLayer(options, options.layerID, options.strategy, options.extent, options.featureLoader, options.paint, options.layout, options.sourceOptions);"},{"kind":"function","name":"onAdd","params":[{"type":{"names":["mapboxgl.Map"]},"description":"<p>MapBoxGL Map 对象。</p>","name":"map"}],"memberof":"FGBLayer","longname":"FGBLayer#onAdd","scope":"instance"},{"kind":"function","name":"onRemove","memberof":"FGBLayer","longname":"FGBLayer#onRemove","scope":"instance"},{"kind":"function","name":"on","memberof":"FGBLayer","longname":"FGBLayer#on","scope":"instance"},{"kind":"function","name":"off","memberof":"FGBLayer","longname":"FGBLayer#off","scope":"instance"},{"kind":"function","name":"once","memberof":"FGBLayer","longname":"FGBLayer#once","scope":"instance"},{"kind":"function","name":"moveLayer","memberof":"FGBLayer","longname":"FGBLayer#moveLayer","scope":"instance"},{"kind":"function","name":"render","memberof":"FGBLayer","longname":"FGBLayer#render","scope":"instance"},{"kind":"function","name":"setVisibility","description":"<p>设置图层的显隐</p>","memberof":"FGBLayer","longname":"FGBLayer#setVisibility","scope":"instance"}]