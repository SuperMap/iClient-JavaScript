[{"kind":"class","name":"MapvLayer","tags":[{"originalTitle":"category","title":"category","text":"Visualization MapV","value":"Visualization MapV"}],"classdesc":"<p>Mapv 图层类。MapV 是一款地理信息可视化开源库，MapV 图层可以用来展示大量地理信息数据，点、线、面的数据，每种数据也有不同的展示类型，如直接打点、热力图、网格、聚合等方式展示数据。<br>\n展示大量的点数据：如热力图、网格、蜂窝状、点聚合、按颜色区间、按半径大小等方式。<br>\n展示大量的线数据：如普通画线、高亮叠加、热力线数据展示等方式，适合展示大量轨迹的场景。<br>\n展示大量的自定义面数据：按颜色区间来展示，如展示行政区划数据。</p>","modulecategory":{"globalParams":{"monospaceLinks":true,"cleverLinks":true,"default":{"outputSourceFiles":false},"namespace":"mapboxgl.supermap","moduleName":"mapboxgl","npm":"@supermapgis/iclient-mapboxgl","cdn":"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js"},"category":"Overlay","name":"mapboxgl.supermap.MapvLayer","des_en":"MapvLayer","className":"MapvLayer","des":"Mapv 图层"},"params":[{"type":{"names":["mapboxgl.Map"]},"description":"<p>MapBoxGL Map 对象，将在下个版本弃用，请用 map.addLayer() 方法添加图层。</p>","name":"map"},{"type":{"names":["Mapv.DataSet"]},"description":"<p>MapV 图层数据集。</p>","name":"dataSet"},{"type":{"names":["Object"]},"description":"<p>Mapv 参数。</p>","name":"mapVOptions"},{"type":{"names":["string"]},"optional":true,"description":"<p>图层 ID。默认使用 CommonUtil.createUniqueID(&quot;mapvLayer_&quot;) 创建专题图层 ID。</p>","name":"mapVOptions.layerID"}],"usage":{"className":"MapvLayer","aliasClass":"","globalParams":{"monospaceLinks":true,"cleverLinks":true,"default":{"outputSourceFiles":false},"namespace":"mapboxgl.supermap","moduleName":"mapboxgl","npm":"@supermapgis/iclient-mapboxgl","cdn":"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js"},"deprecatedClasses":[],"deprecatedClassInstance":null,"browserNamespace":""},"longname":"MapvLayer","scope":"global","usageCodeBrowser":"<script type='text/javascript' src=\"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js\"></script>\n<script>\n  new mapboxgl.supermap.MapvLayer(map, dataSet, mapVOptions, mapVOptions.layerID);\n</script>","usageCodeES6":"import { MapvLayer } from '@supermapgis/iclient-mapboxgl';\n\nnew MapvLayer(map, dataSet, mapVOptions, mapVOptions.layerID);"},{"kind":"function","name":"onAdd","description":"<p>添加图层到地图。</p>","params":[{"type":{"names":["Object"]},"description":"<p>地图对象。</p>","name":"map"}],"memberof":"MapvLayer","longname":"MapvLayer#onAdd","scope":"instance"},{"kind":"function","name":"onRemove","description":"<p>移除图层。</p>","memberof":"MapvLayer","longname":"MapvLayer#onRemove","scope":"instance"},{"kind":"function","name":"render","description":"<p>渲染图层。</p>","memberof":"MapvLayer","longname":"MapvLayer#render","scope":"instance"},{"kind":"function","name":"addData","description":"<p>追加数据。</p>","params":[{"type":{"names":["Object"]},"description":"<p>要追加的数据。</p>","name":"data"},{"type":{"names":["Object"]},"description":"<p>要追加的值。</p>","name":"options"}],"memberof":"MapvLayer","longname":"MapvLayer#addData","scope":"instance"},{"kind":"function","name":"update","description":"<p>更新图层。</p>","params":[{"type":{"names":["Object"]},"description":"<p>待更新的数据。</p>","name":"opt"},{"type":{"names":["Object"]},"description":"<p>mapv 数据集。</p>","name":"opt.data"},{"type":{"names":["Object"]},"description":"<p>mapv 绘制参数。</p>","name":"opt.options"}],"memberof":"MapvLayer","longname":"MapvLayer#update","scope":"instance"},{"kind":"function","name":"getData","description":"<p>获取数据。</p>","returns":[{"type":{"names":["Mapv.DataSet"]},"description":"<p>mapv 数据集。</p>"}],"memberof":"MapvLayer","longname":"MapvLayer#getData","scope":"instance"},{"kind":"function","name":"removeData","description":"<p>删除符合过滤条件的数据。</p>","params":[{"type":{"names":["function"]},"optional":true,"description":"<p>过滤条件。条件参数为数据项，返回值为 true,表示删除该元素；否则表示不删除。</p>","name":"filter"}],"examples":["filter=function(data){\n   if(data.id==\"1\"){\n     return true\n   }\n   return false;\n}"],"memberof":"MapvLayer","longname":"MapvLayer#removeData","scope":"instance"},{"kind":"function","name":"clearData","description":"<p>清除数据。</p>","memberof":"MapvLayer","longname":"MapvLayer#cl