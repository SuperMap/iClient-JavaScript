ledgeGraph","longname":"KnowledgeGraph#refreshItem","scope":"instance"},{"kind":"function","name":"refreshPositions","description":"<p>当节点位置发生变化时，刷新所有节点位置，并重计算边的位置。</p>","memberof":"KnowledgeGraph","longname":"KnowledgeGraph#refreshPositions","scope":"instance"},{"kind":"function","name":"on","description":"<p>graph 监听事件。</p>","params":[{"type":{"names":["string"]},"description":"<p>事件名，可选事件名参见：Node交互事件名、Edge 交互事件名、Canvas 交互事件名、时机事件.\n通用事件名：click dbclick mouseenter mousemove mouseout mouseover mouseleave mousedown mouseup contextmenu dragstart drag dragend dragenter dragleave drop keydown keyup wheel touchstart touchmove touchend <br>\nNode交互事件名：node:通用事件名，例如 node:click<br>\nEdge交互事件名：edge:通用事件名，例如 edge:click<br>\nCanvas交互事件名：canvas:通用事件名，例如 canvas:click<br>\n时机事件：用于监听图的某方法调用前后的时机。<br>\nbeforerender 调用 render 方法之前触发<br>\nafterrender 调用 render 方法之后触发<br>\nbeforeadditem \t调用 addItem 方法之前触发<br>\nafteradditem 调用 addItem 方法之后触发<br>\nbeforeremoveitem 调用 removeItem 方法之前触发<br>\nafterremoveitem 调用 removeItem 方法之后触发<br>\nbeforeupdateitem 调用 updateItem 方法之前触发<br>\nafterupdateitem 调用 updateItem 方法之后触发<br>\nbeforegraphrefresh 调用 refresh 方法之前触发<br>\naftergraphrefresh 调用 refresh 方法之后触发<br>\nbeforelayout\t布局前触发。调用 graph.render 时会进行布局，因此 render 时会触发。或用户主动调用图的 graph.layout 时触发<br>\nafterlayout 布局完成后触发。调用 graph.render 时会进行布局，因此 render 时布局完成后会触发。或用户主动调用图的 graph.layout 时布局完成后触发<br>\nviewportchange 调用 graph.moveTo 或 graph.zoom 均会触发该事件</p>","name":"eventName"},{"type":{"names":["function"]},"description":"<p>监听函数。</p>","name":"handler"}],"memberof":"KnowledgeGraph","longname":"KnowledgeGraph#on","scope":"instance"},{"kind":"function","name":"off","description":"<p>graph 关闭事件。</p>","params":[{"type":{"names":["string"]},"description":"<p>事件名，参考 on 方法的事件名。</p>","name":"eventName"},{"type":{"names":["function"]},"description":"<p>监听函数。</p>","name":"handler"}],"memberof":"KnowledgeGraph","longname":"KnowledgeGraph#off","scope":"instance"},{"kind":"function","name":"toDataURL","description":"<p>转换成图片。</p>","params":[{"type":{"names":["string"]},"description":"<p>图片类型 'image/png' / 'image/jpeg' / 'image/webp' / 'image/bmp'。</p>","name":"type"},{"type":{"names":["string"]},"optional":true,"description":"<p>图片的背景色，可选，不传值时将导出透明背景的图片。</p>","name":"backgroundColor"}],"returns":[{"type":{"names":["string"]},"description":"<p>返回值表示生成的图片的 URL。</p>"}],"memberof":"KnowledgeGraph","longname":"KnowledgeGraph#toDataURL","scope":"instance"},{"kind":"function","name":"nodeLabelOpenEllipsis","description":"<p>转换 label 的省略号。</p>","params":[{"type":{"names":["Object"]},"description":"<p>node 节点标签是否开启省略号。</p>","name":"nodeLabelMaxWidth"},{"type":{"names":["Object"]},"description":"<p>graph 的 nodes 数据。</p>","name":"nodes"}],"returns":[{"type":{"names":["Array"]},"description":"<p>nodes</p>"}],"memberof":"KnowledgeGraph","longname":"KnowledgeGraph#nodeLabelOpenEllipsis","scope":"instance"},{"kind":"function","name":"clear","description":"<p>清除画布元素。</p>","params":[{"type":{"names":["Object"]},"optional":true,"defaultvalue":"this.graph","description":"<p>graph 实例。</p>","name":"graph"}],"memberof":"KnowledgeGraph","longname":"KnowledgeGraph#clear","scope":"instance"},{"kind":"function","name":"destroy","description":"<p>销毁画布。</p>","params":[{"type":{"names":["Object"]},"optional":true,"defaultvalue":"this.graph","description":"<p>graph 实例。</p>","name":"graph"}],"memberof":"KnowledgeGraph","longname":"KnowledgeGraph#destroy","scope":"instance"},{"access":"private","description":"<p>大于最大宽度的字符串会返回带有省略号的字符串 xxx...。</p>","params":[{"type":{"names":["string"]},"description":"<p>需要处理的字符串。</p>","name":"label"},{"type":{"names":["number"]},"description":"<p>最大宽度。</p>","name":"maxWidth"},{"type":{"names":["number"]},"description":"<p>字体大小。</p>","name":"fontSize"}],"returns":[{"type":{"names":["string"]},"description":"<p>处理之后的字符串。</p>"}],"name":"fittingStr","longname":"fittingStr","kind":"function","scope":"global"}]