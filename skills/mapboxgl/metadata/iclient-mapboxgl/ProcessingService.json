ack"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["number"]},"optional":true,"defaultvalue":1000,"description":"<p>获取创建成功结果的时间间隔。</p>","name":"seconds"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#addOverlayGeoJob","scope":"instance"},{"kind":"function","name":"getoverlayGeoJobState","description":"<p>获取叠加分析的状态。</p>","params":[{"type":{"names":["string"]},"description":"<p>叠加分析的 ID。</p>","name":"id"}],"returns":[{"type":{"names":["Object"]},"description":"<p>叠加分析的状态。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getoverlayGeoJobState","scope":"instance"},{"kind":"function","name":"getBuffersJobs","description":"<p>获取缓冲区分析的列表。</p>","params":[{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getBuffersJobs","scope":"instance"},{"kind":"function","name":"getBuffersJob","description":"<p>获取指定 ID 的缓冲区分析。</p>","params":[{"type":{"names":["string"]},"description":"<p>缓冲区分析的 ID。</p>","name":"id"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getBuffersJo