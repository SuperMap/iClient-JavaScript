[{"kind":"class","name":"ProcessingService","tags":[{"originalTitle":"category","title":"category","text":"iServer ProcessingService","value":"iServer ProcessingService"}],"classdesc":"<p>分布式分析相关服务类。分布式分析服务采用了分布式计算技术，可对超大体量空间数据集进行分布式空间分析和数据处理。\n提供方法：缓冲区分析任务、核密度分析任务、叠加分析任务、单对象空间查询任务、点聚合分析任务、区域汇总分析任务、拓扑检查分析任务、矢量裁剪分析任务等。</p>","modulecategory":{"globalParams":{"monospaceLinks":true,"cleverLinks":true,"default":{"outputSourceFiles":false},"namespace":"mapboxgl.supermap","moduleName":"mapboxgl","npm":"@supermapgis/iclient-mapboxgl","cdn":"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js"},"category":"Services","name":"mapboxgl.supermap.ProcessingService","des_en":"ProcessingService","className":"ProcessingService","des":"分布式分析相关服务"},"augments":["ServiceBase"],"examples":["new ProcessingService(url,options)\n .getKernelDensityJobs(function(result){\n    //doSomething\n})"],"params":[{"type":{"names":["string"]},"description":"<p>服务地址。</p>","name":"url"},{"type":{"names":["Object"]},"description":"<p>参数。</p>","name":"options"},{"type":{"names":["string"]},"optional":true,"description":"<p>服务代理地址。</p>","name":"options.proxy"},{"type":{"names":["boolean"]},"optional":true,"description":"<p>请求是否携带凭据。默认情况下，仅同源请求包含凭据。</p>","name":"options.withCredentials"},{"type":{"names":["boolean"]},"optional":true,"description":"<p>是否允许跨域请求。</p>","name":"options.crossOrigin"},{"type":{"names":["Object"]},"optional":true,"description":"<p>请求头。</p>","name":"options.headers"}],"usage":{"className":"ProcessingService","aliasClass":"","globalParams":{"monospaceLinks":true,"cleverLinks":true,"default":{"outputSourceFiles":false},"namespace":"mapboxgl.supermap","moduleName":"mapboxgl","npm":"@supermapgis/iclient-mapboxgl","cdn":"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js"},"deprecatedClasses":[],"deprecatedClassInstance":null,"browserNamespace":""},"longname":"ProcessingService","scope":"global","usageCodeBrowser":"<script type='text/javascript' src=\"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js\"></script>\n<script>\n  new mapboxgl.supermap.ProcessingService(url, options, options.proxy, options.withCredentials, options.crossOrigin, options.headers);\n</script>","usageCodeES6":"import { ProcessingService } from '@supermapgis/iclient-mapboxgl';\n\nnew ProcessingService(url, options, options.proxy, options.withCredentials, options.crossOrigin, options.headers);"},{"kind":"function","name":"getKernelDensityJobs","description":"<p>获取密度分析的列表。</p>","params":[{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getKernelDensityJobs","scope":"instance"},{"kind":"function","name":"getKernelDensityJob","description":"<p>获取指定 ID 的密度分析。</p>","params":[{"type":{"names":["string"]},"description":"<p>空间分析的 ID。</p>","name":"id"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getKernelDensityJob","scope":"instance"},{"kind":"function","name":"addKernelDensityJob","description":"<p>新建密度分析。目前提供 1 种密度分析方法：核密度分析。<br>\n核密度分析是指使用核函数来计算点或线邻域范围内的每单位面积量值。\n其结果是中间值大周边值小的光滑曲面，在邻域边界处降为 0。\n对于点对象，其核密度曲面与下方的平面所围成的空间的体积近似于此点的测量值；\n对于线对象，其核密度曲面与下方的平面所围成的空间的体积近似于此线的测量值与线长度的乘积。\n点或线的邻域叠加处，其密度值也相加。每个输出栅格的密度均为叠加在栅格上的所有核曲面值之和。</p>","params":[{"type":{"names":["KernelDensityJobParameter"]},"description":"<p>密度分析参数类。</p>","name":"params"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["number"]},"optional":true,"defaultvalue":1000,"description":"<p>获取创建成功结果的时间间隔。</p>","name":"seconds"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#addKernelDensityJob","scope":"instance"},{"kind":"function","name":"getKernelDensityJobState","description":"<p>获取密度分析的状态。</p>","params":[{"type":{"names":["string"]},"description":"<p>密度分析的 ID。</p>","name":"id"}],"returns":[{"type":{"names":["Object"]},"description":"<p>密度分析的状态。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getKernelDensityJobState","scope":"instance"},{"kind":"function","name":"getSummaryMeshJobs","description":"<p>获取点聚合分析的列表。</p>","params":[{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getSummaryMeshJobs","scope":"instance"},{"kind":"function","name":"getSummaryMeshJob","description":"<p>获取指定 ID 的点聚合分析。</p>","params":[{"type":{"names":["string"]},"description":"<p>空间分析的 ID。</p>","name":"id"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getSummaryMeshJob","scope":"instance"},{"kind":"function","name":"addSummaryMeshJob","description":"<p>新建点聚合分析。<br>\n点聚合分析是指针对点数据集制作聚合图的一种空间分析作业。通过网格面或多边形对地图点要素进行划分，\n然后，计算每个面对象内点要素的数量，并作为面对象的统计值，也可以引入点的权重信息，\n考虑面对象内点的加权值作为面对象的统计值；最后基于面对象的统计值，按照统计值大小排序的结果，\n通过色带对面对象进行色彩填充。</p>","params":[{"type":{"names":["SummaryMeshJobParameter"]},"description":"<p>点聚合分析任务参数类。</p>","name":"params"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["number"]},"optional":true,"defaultvalue":1000,"description":"<p>获取创建成功结果的时间间隔。</p>","name":"seconds"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#addSummaryMeshJob","scope":"instance"},{"kind":"function","name":"getSummaryMeshJobState","description":"<p>获取点聚合分析的状态。</p>","params":[{"type":{"names":["string"]},"description":"<p>点聚合分析的 ID。</p>","name":"id"}],"returns":[{"type":{"names":["Object"]},"description":"<p>点聚合分析的状态。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getSummaryMeshJobState","scope":"instance"},{"kind":"function","name":"getQueryJobs","description":"<p>获取单对象空间查询分析的列表。</p>","params":[{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getQueryJobs","scope":"instance"},{"kind":"function","name":"getQueryJob","description":"<p>获取指定 ID 的单对象空间查询分析。</p>","params":[{"type":{"names":["string"]},"description":"<p>空间分析的 ID。</p>","name":"id"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getQueryJob","scope":"instance"},{"kind":"function","name":"addQueryJob","description":"<p>新建单对象空间查询分析。<br>\n单对象空间查询，指的是只支持查询对象数据集中有一个对象对被查询数据集做空间查询。\n如果查询对象数据集中有多个对象，则默认用 SmID 最小的对象对被查询数据集做空间查询。</p>","params":[{"type":{"names":["SingleObjectQueryJobsParameter"]},"description":"<p>单对象空间查询分析任务参数。</p>","name":"params"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["number"]},"optional":true,"defaultvalue":1000,"description":"<p>获取创建成功结果的时间间隔。</p>","name":"seconds"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#addQueryJob","scope":"instance"},{"kind":"function","name":"getQueryJobState","description":"<p>获取单对象空间查询分析的状态。</p>","params":[{"type":{"names":["string"]},"description":"<p>单对象空间查询分析的 ID。</p>","name":"id"}],"returns":[{"type":{"names":["Object"]},"description":"<p>单对象空间查询分析的状态。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getQueryJobState","scope":"instance"},{"kind":"function","name":"getSummaryRegionJobs","description":"<p>获取区域汇总分析的列表。</p>","params":[{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getSummaryRegionJobs","scope":"instance"},{"kind":"function","name":"getSummaryRegionJob","description":"<p>获取指定 ID 的区域汇总分析。</p>","params":[{"type":{"names":["string"]},"description":"<p>区域汇总分析的 ID。</p>","name":"id"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getSummaryRegionJob","scope":"instance"},{"kind":"function","name":"addSummaryRegionJob","description":"<p>新建区域汇总分析。<br>\n区域汇总分析是指针对线数据集和面数据集制作聚合图的一种空间分析作业。\n通过网格面或多边形对地图线或面要素进行划分，然后，以标准属性字段或权重字段对每个网格单元内线或面要素进行统计，\n将统计结果作为该网格单元的统计值。最后按照网格单元统计值的大小进行排序，通过色带对网格单元进行色彩填充。</p>","params":[{"type":{"names":["SummaryRegionJobParameter"]},"description":"<p>区域汇总分析参数类。</p>","name":"params"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["number"]},"optional":true,"defaultvalue":1000,"description":"<p>获取创建成功结果的时间间隔。</p>","name":"seconds"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#addSummaryRegionJob","scope":"instance"},{"kind":"function","name":"getSummaryRegionJobState","description":"<p>获取区域汇总分析的状态。</p>","params":[{"type":{"names":["string"]},"description":"<p>生成区域汇总分析的 ID。</p>","name":"id"}],"returns":[{"type":{"names":["Object"]},"description":"<p>区域汇总分析的状态。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getSummaryRegionJobState","scope":"instance"},{"kind":"function","name":"getVectorClipJobs","description":"<p>获取矢量裁剪分析的列表。</p>","params":[{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getVectorClipJobs","scope":"instance"},{"kind":"function","name":"getVectorClipJob","description":"<p>获取指定 ID 的矢量裁剪分析。</p>","params":[{"type":{"names":["string"]},"description":"<p>矢量裁剪分析的 ID。</p>","name":"id"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"description":"<p>Promise 对象。</p>"}],"memberof":"ProcessingService","longname":"ProcessingService#getVectorClipJob","scope":"instance"},{"kind":"function","name":"addVectorClipJob","description":"<p>新建矢量裁剪分析。<br>\n矢量裁剪是指对矢量数据集进行裁剪，包括内部裁剪和外部裁剪。\n内部裁剪，则被裁剪的矢量数据集在裁剪区范围内的部分被保留到结果数据集中；\n外部裁剪，则保留不在裁剪区范围内的那部分数据到结果数据集中。</p>","params":[{"type":{"names":["VectorClipJobsParameter"]},"description":"<p>矢量裁剪分析任务参数类。</p>","name":"params"},{"type":{"names":["RequestCallback"]},"optional":true,"description":"<p>回调函数，该参数未传时可通过返回的 promise 获取结果。</p>","name":"callback"},{"type":{"names":["number"]},"optional":true,"defaultvalue":1000,"description":"<p>获取创建成功结果的时间间隔。</p>","name":"seconds"},{"type":{"names":["DataFormat"]},"optional":true,"defaultvalue":"DataFormat.GEOJSON","description":"<p>返回结果类型。</p>","name":"resultFormat"}],"returns":[{"type":{"names":["Promise"]},"descripti