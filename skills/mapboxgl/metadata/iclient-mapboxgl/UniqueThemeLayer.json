[{"kind":"class","name":"UniqueThemeLayer","tags":[{"originalTitle":"category","title":"category","text":"Visualization Theme","value":"Visualization Theme"}],"classdesc":"<p>客户端单值专题图图层类。单值专题图是利用不同的颜色或符号（线型、填充）表示图层中某一属性信息的不同属性值，\n属性值相同的要素具有相同的渲染风格。单值专题图多用于具有分类属性的地图上， 比如土壤类型分布图、土地利用图、行政区划图等。\n单值专题图着重表示现象质的差别，一般不表示数量的特征。尤其是有交叉或重叠现象时，此类不推荐使用，例如：民族分布区等。</p>","modulecategory":{"globalParams":{"monospaceLinks":true,"cleverLinks":true,"default":{"outputSourceFiles":false},"namespace":"mapboxgl.supermap","moduleName":"mapboxgl","npm":"@supermapgis/iclient-mapboxgl","cdn":"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js"},"category":"Overlay","name":"mapboxgl.supermap.UniqueThemeLayer","des_en":"UniqueThemeLayer","className":"UniqueThemeLayer","des":"客户端单值专题图图层"},"params":[{"type":{"names":["string"]},"description":"<p>图层名。</p>","name":"name"},{"type":{"names":["Object"]},"description":"<p>参数。</p>","name":"opt_options"},{"type":{"names":["string"]},"description":"<p>指定创建专题图字段。</p>","name":"opt_options.themeField"},{"type":{"names":["Object"]},"description":"<p>专题图样式。</p>","name":"opt_options.style"},{"type":{"names":["Object"]},"description":"<p>各专题类型样式组。</p>","name":"opt_options.styleGroups"},{"type":{"names":["mapboxgl.Map"]},"description":"<p>MapBoxGL Map 对象。</p>","name":"opt_options.map"},{"type":{"names":["string"]},"optional":true,"description":"<p>专题图层 ID。默认使用 CommonUtil.createUniqueID(&quot;themeLayer_&quot;) 创建专题图层 ID。</p>","name":"opt_options.id"},{"type":{"names":["boolean"]},"optional":true,"defaultvalue":true,"description":"<p>是否实时重绘。</p>","name":"opt_options.loadWhileAnimating"},{"type":{"names":["number"]},"optional":true,"defaultvalue":1,"description":"<p>图层不透明度。</p>","name":"opt_options.opacity"},{"type":{"names":["boolean"]},"optional":true,"defaultvalue":false,"description":"<p>是否开启 hover 事件。</p>","name":"opt_options.isHoverAble"},{"type":{"names":["Object"]},"optional":true,"description":"<p>hover 的高亮样式。</p>","name":"opt_options.highlightStyle"}],"augments":["GeoFeatureThemeLayer"],"usage":{"className":"UniqueThemeLayer","aliasClass":"","globalParams":{"monospaceLinks":true,"cleverLinks":true,"default":{"outputSourceFiles":false},"namespace":"mapboxgl.supermap","moduleName":"mapboxgl","npm":"@supermapgis/iclient-mapboxgl","cdn":"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js"},"deprecatedClasses":[],"deprecatedClassInstance":null,"browserNamespace":""},"longname":"UniqueThemeLayer","scope":"global","usageCodeBrowser":"<script type='text/javascript' src=\"https://iclient.supermap.io/dist/mapboxgl/iclient-mapboxgl.js\"></script>\n<script>\n  new mapboxgl.supermap.UniqueThemeLayer(name, opt_options, opt_options.themeField, opt_options.style, opt_options.styleGroups, opt_options.map, opt_options.id, opt_options.loadWhileAnimating, opt_options.opacity, opt_options.isHoverAble, opt_options.highlightStyle);\n</script>","usageCodeES6":"import { UniqueThemeLayer } from '@supermapgis/iclient-mapboxgl';\n\nnew UniqueThemeLayer(name, opt_options, opt_options.themeField, opt_options.style, opt_options.styleGroups, opt_options.map, opt_options.id, opt_options.loadWhileAnimating, opt_options.opacity, opt_options.isHoverAble, opt_options.highlightStyle);"},{"access":"private","kind":"function","name":"createThematicFeature","description":"<p>创建专题图要素。</p>","params":[{"type":{"names":["Object"]},"description":"<p>要创建的专题图形要素。</p>","name":"feature"}],"memberof":"UniqueThemeLayer","longname":"UniqueThemeLayer#createThematicFeature","scope":"instance","overrides":"GeoFeatureThemeLayer#createThematicFeature"},{"access":"private","kind":"function","name":"getStyleByData","description":"<p>通过数据获取 style。</p>","params":[{"type":{"names":["Object"]},"description":"<p>要素数据。</p>","name":"fea"}],"memberof":"UniqueThemeLayer","longname":"UniqueThemeLayer#getStyleByData","scope":"instance"}]