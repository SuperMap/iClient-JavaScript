{
  "mapOptions": {
    "container": "map",
    "center": [0, 0],
    "zoom": 2,
    "bearing": 0,
    "pitch": 0,
    "maxZoom": 22,
    "minZoom": 0
  },
  "style": {
    "emptyStyle": {
      "version": 8,
      "sources": {},
      "layers": []
    },
    "note": "initMap 的 mapOptions 中不得传 style，否则会覆盖自动生成的样式"
  },
  "initMap": {
    "defaultType": "raster",
    "note": "initMap 解析时地图实例已创建，但样式尚未加载完成；添加数据源和图层前需等待 load 事件"
  },
  "bufferAnalysis": {
    "defaultEndType": "ROUND",
    "apiDefaultEndType": "FLAT",
    "defaultLeftDistance": 100,
    "defaultRightDistance": 100,
    "defaultSemicircleLineSegment": 10,
    "apiDefaultSemicircleLineSegment": 4,
    "defaultRadiusUnit": "METER"
  },
  "vectorTile": {
    "sourceType": "vector",
    "tileWidth": 512,
    "tileHeight": 512,
    "note": "source-layer 和瓦片坐标模板必须按对应 MapLibreGL 示例及服务元数据确认"
  },
  "ogcRaster": {
    "sourceType": "raster",
    "layerType": "raster",
    "wmsTileSize": 256,
    "defaultCRS": "EPSG:3857",
    "wmtsTileSize": "从 Capabilities 的 TileWidth/TileHeight 读取",
    "note": "WMTS/WMS 的 URL、图层、矩阵级别、格式和边界优先从 Capabilities 读取；不支持的投影或矩阵映射必须报错"
  },
  "layer": {
    "defaultCircleRadius": 6,
    "defaultLineWidth": 3,
    "defaultFillOpacity": 0.5,
    "defaultLineColor": "#ff0000",
    "defaultFillColor": "#ff8800",
    "defaultBufferColor": "#00ff00"
  },
  "geojsonStyle": {
    "defaultCircleRadius": 6,
    "defaultLineWidth": 3,
    "defaultFillOpacity": 0.5
  },
  "featureService": {
    "fgbFormat": "FGB",
    "note": "FGB 查询结果通过 result.newResourceLocation 返回，使用前确认服务支持"
  },
  "cdns": {
    "enhanceVersion": "5.9.0-2",
    "maplibreGlVersion": "5.6.0",
    "enhance": {
      "js": "https://iclient.supermap.io/web/libs/maplibre-gl-js-enhance/5.9.0-2/maplibre-gl-enhance.js",
      "css": "https://iclient.supermap.io/web/libs/maplibre-gl-js-enhance/5.9.0-2/maplibre-gl-enhance.css"
    },
    "iclient": {
      "js": "https://iclient.supermap.io/dist/maplibregl/iclient-maplibregl-es6.min.js",
      "css": "https://iclient.supermap.io/dist/maplibregl/iclient-maplibregl.min.css"
    },
    "note": "CDN 版本固定，与 dist/maplibregl/include-maplibregl.js 加载的版本一致，不按用户要求切换"
  }
}
